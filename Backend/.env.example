# PostgreSQL (pgAdmin 4)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bmi2_crm
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=5001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Which account-intelligence provider serves GET /companies/:id/intelligence.
# Unset or "mock" -> clearly-labelled SAMPLE CONTENT (the default, and what runs
# today). "leadgen" is not built and throws at startup rather than falling back,
# so a deployment cannot quietly show placeholder news while believing the real
# integration is live. See services/accountIntelligence/index.ts.
ACCOUNT_INTELLIGENCE_PROVIDER=
