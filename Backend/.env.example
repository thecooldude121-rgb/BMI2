# PostgreSQL (pgAdmin 4)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bmi2_crm
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=5001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Encrypts API keys this CRM stores for OUTBOUND calls to another module
# (module_links.api_key_encrypted, migration 047 — today only Lead Gen).
# Only needed once a module link is configured; the app boots without it.
# Generate with: openssl rand -hex 32
#
# ***  NEVER ROTATE THIS ONCE A MODULE LINK EXISTS.  ***
# The stored Lead Gen credential is encrypted with this exact key. Change it and
# that credential becomes undecryptable — and the failure is QUIET: the link row
# still reads as connected, but every account-intelligence panel reports "not
# linked" because the key cannot be read back. Recovering means generating a new
# setup code in Connected Modules and re-running the whole handshake from Lead
# Gen's side. Treat it like a database password, not like a rotatable secret.
MODULE_LINK_ENCRYPTION_KEY=

# The restricted, read-only connection reports run on (migration 055).
#
# Reports execute as `bmi_reports_ro`, which holds SELECT on the reportable
# tables only and is constrained by row-level security. The application role
# owns those tables and is typically a superuser, so it BYPASSES those policies
# — which is why reports must never run as it, and why the pool refuses to
# start if REPORTS_DB_USER equals DB_USER or is unset. There is deliberately no
# fallback: a fallback would silently disable the isolation this exists for.
#
# Generate and store with:  npm run db:reports-role
# (writes both values to .env; the password is never printed)
REPORTS_DB_USER=
REPORTS_DB_PASSWORD=
